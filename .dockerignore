# ---------------------------------------------------------------------------
# Build context exclusions — everything that is rebuilt inside the image or
# must never be baked into it.
# ---------------------------------------------------------------------------

# Version control
.git
.gitignore
.github

# Dependencies & compiled assets (npm ci / npm run build inside the image)
node_modules
vendor
public/build
public/hot
public/storage
bootstrap/ssr

# Secrets & local environment
.env
.env.*
!.env.example

# Runtime state (logs, caches, sessions, uploaded files)
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
storage/*.key
bootstrap/cache/*.php

# Tooling leftovers
.phpunit.cache
.phpactor.json
auth.json
npm-debug.log
yarn-error.log
Homestead.json
Homestead.yaml
.idea
.vscode
.fleet
.nova
.zed
.DS_Store
Thumbs.db

# Docker descriptors are not needed inside the image
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore