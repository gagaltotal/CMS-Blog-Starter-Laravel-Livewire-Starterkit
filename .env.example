APP_NAME="CMS Blog Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# IMPORTANT: set APP_DEBUG=false and a strong, unique APP_KEY before ever
# deploying this application anywhere other than your own machine.
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database (MySQL)
# --------------------------------------------------------------------------
# Create the database first, e.g.: CREATE DATABASE cms_blog CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_blog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set SESSION_SECURE_COOKIE=true once you serve the app over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# For local development, MAIL_MAILER=log writes emails (e.g. email
# verification, password reset) to storage/logs/laravel.log instead of
# actually sending them. Point this at Mailpit/Mailtrap/SMTP for real mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Seeded admin account (used only by database/seeders/AdminUserSeeder.php)
# --------------------------------------------------------------------------
# These are only used when APP_ENV=local. In any other environment the
# seeder refuses to use a fixed password and generates a random one instead
# (printed once to the console) unless you set ADMIN_SEED_PASSWORD yourself.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

CMS_ADMIN_POSTS_PER_PAGE=6
CMS_POSTS_PER_PAGE=10